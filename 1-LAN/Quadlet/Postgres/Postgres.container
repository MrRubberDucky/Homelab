[Unit]
Description=PostgreSQL

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Container]
Image=public.ecr.aws/docker/library/postgres:18-trixie
ContainerName=postgres
EnvironmentFile=%h/Environments/Example/.pgenv
Mount=type=bind,src=%h/Databases/Example,dst=/var/lib/postgresql,U=true,Z
Volume=Postgres_Socket:/var/run/postgresql:z
Tmpfs=/dev/shm
HealthCmd=["CMD-SHELL", "psql -U $${POSTGRES_USER} -d $${POSTGRES_DB} -c 'SELECT 1' || exit 1"]
HealthInterval=5s
HealthRetries=5
HealthTimeout=5s
Notify=healthy
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Network=none
User=999:999
UserNS=auto:size=1000
