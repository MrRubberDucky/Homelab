https://example.com {
  # Serve on /mediamtx*
  handle_path /mediamtx/* {
     @protected {
         not path /*/whip /*/whip/*
     }
     # TinyAuth handles forward_auth since Pocket ID does not have native support for it
     forward_auth @protected tinyauth:3000 {
         uri /api/auth/caddy
         header_up X-Forwarded-Uri {http.request.orig_uri}
         copy_headers Authorization
     }
     reverse_proxy {
         to host.containers.internal:8889
         header_down Location ^/ /stream/
     }
  handle {
         # Actual site contents here
  }
}
