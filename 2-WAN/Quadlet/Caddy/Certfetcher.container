[Unit]
Description=Certificate Fetcher

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Install]
WantedBy=default.target

[Container]
Image=ghcr.io/rubberverse/qor-caddy:latest
ContainerName=qor-certfetcher
Exec=run --config /app/configs/Caddyfile
EnvironmentFile=%h/Environments/Caddy/.env2
Volume=%h/Configs/Fetcher/Caddyfile:/app/configs/Caddyfile:ro,Z
Volume=%h/Appdata/Fetcher-Data:/app/.local/share/caddy:U,z
Volume=certfetcher_data:/app/.config/caddy:U,z
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Network=certfetcher.network
Sysctl=net.ipv4.ip_unprivileged_port_start=80
DNS=1.1.1.1
DNS=1.0.0.1
Memory=32M
User=1100:1100
UserNS=auto:size=1101
