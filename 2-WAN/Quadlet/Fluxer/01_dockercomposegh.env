# filename: .env
# type: .env env
# desc: some docker-compose.yaml envs + .env.example (most have been moved to .sysenv though)
FLUXER_EDGE_BIND=127.0.0.1:8080
FLUXER_EDGE_TRUSTED_PROXIES=private_ranges
FLUXER_PUBLIC_ORIGIN=https://hornchat.domain.tld
FLUXER_EDGE_SITE_ADDRESS=hornchat.domain.tld
FLUXER_DOMAIN=hornchat.domain.tld
FLUXER_PUBLIC_SCHEME=https
FLUXER_PUBLIC_PORT=443
# The api and the Rust services name their fixed Postgres statement shapes so the
# server can reuse their plans. Named prepared statements require a session that
# outlives the transaction, so set this to false if you put a transaction-pooling
# connection pooler such as PgBouncer in front of Postgres. One setting governs
# every service.
FLUXER_POSTGRES_PREPARED_STATEMENTS=true
# docker-compose.yaml variables
# x-fluxer-postgres-env
FLUXER_DATABASE_BACKEND=postgres
FLUXER_POSTGRES_HOST=fluxer-postgres
FLUXER_POSTGRES_PORT=5432
FLUXER_POSTGRES_USERNAME=fluxer-database-example
FLUXER_POSTGRES_PASSWORD=1234
FLUXER_POSTGRES_SSL=false
# CSP
#FLUXER_CSP_EXTRA_DEFAULT_SRC=
FLUXER_CSP_EXTRA_CONNECT_SRC=wss://cranking.hogs.tld:7881, https://analytics.example.tld
FLUXER_CSP_EXTRA_IMG_SRC=https://steamedhams.example.tld, https://hotravioli.bolognese.tld
#FLUXER_CSP_EXTRA_MEDIA_SRC=
#FLUXER_CSP_EXTRA_FONT_SRC=
FLUXER_CSP_EXTRA_SCRIPT_SRC=https://analytics.example.tld
#FLUXER_CSP_EXTRA_STYLE_SRC=
#FLUXER_CSP_EXTRA_FRAME_SRC=
#FLUXER_CSP_EXTRA_WORKER_SRC=
#FLUXER_CSP_EXTRA_MANIFEST_SRC=
#FLUXER_CSP_REPORT_URI=
# SSO
FLUXER_SSO_ALLOW_PRIVATE_ADDRESSES=false
# x-fluxer-env
# includes fluxer-postgres-env <<: *fluxer-postgres.env
NODE_ENV=production
FLUXER_ENV=production
FLUXER_SELF_HOSTED=true
FLUXER_BASE_DOMAIN=hornchat.domain.tld
FLUXER_PUBLIC_SCHEME=https
FLUXER_PUBLIC_PORT=443
FLUXER_CADDY_SITE_ADDRESS=:8777
FLUXER_TRUST_CLIENT_IP_HEADER=true
FLUXER_CLIENT_IP_HEADER_NAME=x-forwarded-for
FLUXER_API_HEADERS_TIMEOUT_MS=3000
FLUXER_API_REQUEST_TIMEOUT_MS=1200
FLUXER_SELF_HOSTED=true
FLUXER_ERLANG_SCHEDULERS_MIN=2
FLUXER_ERLANG_SCHEDULERS_MAX=2
# Fluxer Discovery
FLUXER_DISCOVERY_ENABLED=true
# Valkey & NATS
FLUXER_KV_URL=redis://fluxer-valkey:6379/0
FLUXER_NATS_URL=nats://fluxer-nats:4222
FLUXER_NATS_JETSTREAM_URL=nats://fluxer-nats:4222
FLUXER_SVC_NATS_URL=nats://fluxer-nats:4222
FLUXER_NATS_AUTH_TOKEN=openssl rand -hex 32
# S3
FLUXER_S3_ENDPOINT=http://fluxer-seaweedfs:8333
FLUXER_S3_PUBLIC_ENDPOINT=http://fluxer-seaweedfs:8333
FLUXER_S3_REGION=pl-waw-1
FLUXER_S3_ACCESS_KEY_ID=fluxer
FLUXER_S3_SECRET_ACCESS_KEY=openssl rand -hex 32
FLUXER_S3_FORCE_PATH_STYLE=true
FLUXER_S3_BUCKET_CDN=fluxer
FLUXER_S3_BUCKET_UPLOADS=fluxer-uploads
FLUXER_S3_BUCKET_DOWNLOADS=fluxer-downloads
FLUXER_S3_BUCKET_REPORTS=fluxer-reports
FLUXER_S3_BUCKET_HARVESTS=fluxer-harvests
# S3 - AWS
#AWS_SECRET_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=
#AWS_EC2_METADATA_DISABLED=true
# Meilisearch
FLUXER_SEARCH_ENGINE=meilisearch
FLUXER_SEARCH_URL=http://fluxer-meilisearch:7700
FLUXER_SEARCH_API_KEY=
# Secrets
FLUXER_SUDO_MODE_SECRET=openssl rand -hex 32
FLUXER_CONNECTION_INITIATION_SECRET=openssl rand -hex 32
FLUXER_SSO_ALLOW_PRIVATE_ADDRESSES=false
FLUXER_VAPID_EMAIL=vapid-fluxer@myballsitch.tld
FLUXER_VAPID_PUBLIC_KEY=openssl rand -hex 32
FLUXER_VAPID_PRIVATE_KEY=openssl rand -hex 32
FLUXER_PASSKEY_RP_ID=hornchat.domain.tld
FLUXER_PASSKEY_RP_NAME=OnlyHorns
FLUXER_PASSKEY_ADDITIONAL_ALLOWED_ORIGINS=https://hornchat.domain.tld
FLUXER_GATEWAY_RPC_AUTH_TOKEN=openssl rand -hex 32
FLUXER_ERLANG_COOKIE=openssl rand -hex 32
FLUXER_MEDIA_PROXY_SECRET_KEY=openssl rand -hex 32
FLUXER_MEDIA_PROXY_UPLOAD_RELAY_SECRET_BASE64=openssl rand -hex 32
FLUXER_ADMIN_SECRET_KEY_BASE=openssl rand -hex 32
FLUXER_ADMIN_OAUTH_CLIENT_SECRET=openssl rand -hex 32
# Internal endpoints
FLUXER_INTERNAL_API_ENDPOINT=http://fluxer-api:8080
FLUXER_INTERNAL_GATEWAY_ENDPOINT=http://fluxer-gateway:8080
FLUXER_INTERNAL_MEDIA_PROXY_ENDPOINT=http://fluxer-media-proxy:8080
FLUXER_MARKETING_ENDPOINT=https://hornchat.domain.tld
FLUXER_MEDIA_PROXY_ENDPOINT=http://fluxer-media-proxy:8080
FLUXER_MEDIA_ENDPOINT=https://hornchat.domain.tld/media
FLUXER_MEDIA_PROXY_UPLOAD_RELAY_ENDPOINT=https://hornchat.domain.tld/media
# LiveKit (soon to be deprecated)
FLUXER_LIVEKIT_ENABLED=false
#FLUXER_LIVEKIT_API_KEY=
#FLUXER_LIVEKIT_API_KEY=
#FLUXER_LIVEKIT_API_SECRET
#FLUXER_LIVEKIT_INTERNAL_URL=
#FLUXER_LIVEKIT_WEBHOOK_URL=
#FLUXER_LIVEKIT_DEFAULT_REGION=
#FLUXER_LIVEKIT_URL=
# Third-party service integrations
FLUXER_KLIPY_API_KEY=get it from klipy silly
# E-mail (SMTP)
FLUXER_EMAIL_ENABLED=true
#FLUXER_EMAIL_PROVIDER=
#FLUXER_EMAIL_FROM_EMAIL=
#FLUXER_EMAIL_FROM_NAME=
#FLUXER_EMAIL_APP_BASE_URL=
#FLUXER_EMAIL_SMTP_HOST=
#FLUXER_EMAIL_SMTP_PORT=
#FLUXER_EMAIL_SMTP_USERNAME=
#FLUXER_EMAIL_SMTP_PASSWORD=
#FLUXER_EMAIL_SMTP_SECURE=
# SMS (Twilio)
FLUXER_SMS_ENABLED=false
# Captcha
FLUXER_CAPTCHA_ENABLED=true
#FLUXER_CAPTCHA_HCAPTCHA_SITE_KEY=
#FLUXER_CAPTCHA_HCAPTCHA_SECRET_KEY=
#FLUXER_CAPTCHA_TURNSTILE_SITE_KEY=
#FLUXER_CAPTCHA_TURNSTILE_SECRET_KEY=
# CSAM detection service
FLUXER_NCMEC_ENABLED=false
# Open-source anti-virus
FLUXER_CLAMAV_ENABLED=false
# Stripe Payment
FLUXER_STRIPE_ENABLED=false
