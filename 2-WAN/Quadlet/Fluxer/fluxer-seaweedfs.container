[Unit]
Description=Fluxer SeaweedFS
#Requires=fluxer-seaweedfs-init.service
#Before=fluxer-seaweedfs-init.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=public.ecr.aws/aikido-dev/chrislusf/seaweedfs:latest
ContainerName=fluxer-seaweedfs
Environment=GODEBUG=fips140=on
Entrypoint=/usr/bin/weed
Exec=-logtostderr=${RUBBERVERSE_XYZ_SEAWEEDFS_LOGTOSTDERR} server -s3 -dir=/data -volume.max=${RUBBERVERSE_XYZ_SEAWEEDFS_30GB_BUCKETS_AMOUNT} -master.telemetry=false
Volume=/srv/fluxer/seaweedfs:/data:U,Z
Tmpfs=/tmp:rw,size=1m,noexec,nosuid,nodev
Tmpfs=/var/run:rw,size=1m,noexec,nosuid,nodev
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8333/healthz
HealthInterval=10s
HealthRetries=20
HealthTimeout=5s
Notify=healthy
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
Memory=2G
PodmanArgs=--cpus=2
PodmanArgs=--memory-swap=0M
User=1000:1000
UserNS=auto:size=1001
Network=6Seaweedfs.network
