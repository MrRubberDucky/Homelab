[Unit]
Description=Fluxer Gifs Shard
Requires=fluxer-nats.service
After=fluxer-nats.container

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=${FLUXER_REGISTRY}/fluxer-gifs:${FLUXER_IMAGE_TAG}
ContainerName=fluxer-gifs-shard
Timezone=Europe/Warsaw
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=gifs
Environment=FLUXER_SVC_MODE=shard
Environment=FLUXER_SVC_SHARD_ID=0
Environment=FLUXER_MEDIA_PROXY_PUBLIC_ENDPOINT=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}/media
AutoUpdate=${RUBBERVERSE_XYZ_CONTAINER_AUTOUPDATE}
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=${FLUXER_GIFS_SHARD_MEMORY_LIMIT}
Network=9Nats.network
UserNS=auto