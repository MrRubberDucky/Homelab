[Unit]
Description=Fluxer App Proxy
Requires=fluxer-caddy.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=${FLUXER_REGISTRY}/fluxer-app-proxy-self-hosted:${FLUXER_IMAGE_TAG}
ContainerName=fluxer-app-proxy
Timezone=${RUBBERVERSE_XYZ_CONTAINER_TIMEZONE}
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_APP_PROXY_HOST=0.0.0.0
Environment=FLUXER_APP_PROXY_PORT=8080
Environment=DISCOVERY_UPSTREAM_URL=${RUBBERVERSE_XYZ_APP_DISCOVERY_UPSTREAM_URL}
Environment=PUBLIC_BOOTSTRAP_API_ENDPOINT=/api
Environment=PUBLIC_BOOTSTRAP_API_PUBLIC_ENDPOINT=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}/api
Environment=FLUXER_CSP_EXTRA_DEFAULT_SRC=${FLUXER_CSP_EXTRA_CONNECT_SRC}
Environment=FLUXER_CSP_EXTRA_CONNECT_SRC=${FLUXER_CSP_EXTRA_CONNECT_SRC}
Environment=FLUXER_CSP_EXTRA_IMG_SRC=${FLUXER_CSP_EXTRA_IMG_SRC}
Environment=FLUXER_CSP_EXTRA_MEDIA_SRC=${FLUXER_CSP_EXTRA_MEDIA_SRC}
Environment=FLUXER_CSP_EXTRA_FONT_SRC=${FLUXER_CSP_EXTRA_FONT_SRC}
Environment=FLUXER_CSP_EXTRA_SCRIPT_SRC==${FLUXER_CSP_EXTRA_SCRIPT_SRC}
Environment=FLUXER_CSP_EXTRA_STYLE_SRC=${FLUXER_CSP_EXTRA_STYLE_SRC}
Environment=FLUXER_CSP_EXTRA_FRAME_SRC=${FLUXER_CSP_EXTRA_FRAME_SRC}
Environment=FLUXER_CSP_EXTRA_WORKER_SRC=${FLUXER_CSP_EXTRA_WORKER_SRC}
Environment=FLUXER_CSP_EXTRA_MANIFEST_SRC=${FLUXER_CSP_EXTRA_MANIFEST_SRC}
Environment=FLUXER_CSP_REPORT_URI=${FLUXER_CSP_REPORT_URI}
AutoUpdate=${RUBBERVERSE_XYZ_CONTAINER_AUTOUPDATE}
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=${FLUXER_APP_PROXY_MEMORY_LIMIT}
Network=4AppProxy.network
Network=0API.network
Network=0Caddy.network
Network=7Postgres.network
UserNS=auto
