[Unit]
Description=Fluxer Admin Panel
Requires=\
    fluxer-api.service \
    fluxer-caddy.service

Before=fluxer-caddy.service
After=fluxer-api.service

[Install]
WantedBy=multi-user.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=ghcr.io/fluxerapp/fluxer-admin:v1
ContainerName=fluxer-admin
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_ADMIN_HOST=0.0.0.0
Environment=FLUXER_ADMIN_PORT=8080
Environment=FLUXER_ADMIN_BASE_PATH=/admin
Environment=FLUXER_API_ENDPOINT=http://fluxer-api:8080
Environment=FLUXER_ADMIN_ENDPOINT=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}/admin
Environment=FLUXER_APP_ENDPOINT=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}
Environment=FLUXER_MEDIA_ENDPOINT=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}/media
Environment=FLUXER_STATIC_CDN_ENDPOINT=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}
Environment=FLUXER_ADMIN_OAUTH_REDIRECT_URI=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}/admin/oauth2_callback
Tmpfs=/tmp:rw,size=1m,noexec,nosuid,nodev
Tmpfs=/var/run:rw,size=1m,noexec,nosuid,nodev
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=256M
PodmanArgs=--cpus=1
PodmanArgs=--memory-swap=0M
Network=0Admin.network
Network=0API.network
Network=7Postgres.network
UserNS=auto
