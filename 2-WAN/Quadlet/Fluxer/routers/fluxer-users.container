[Unit]
Description=Fluxer Users Router
Requires=\
    fluxer-nats.service \
    fluxer-users-shard.service

After=fluxer-nats.service

Before=fluxer-users-shard.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=${FLUXER_REGISTRY}/fluxer-users:${FLUXER_IMAGE_TAG}
ContainerName=fluxer-users
Timezone=${RUBBERVERSE_XYZ_CONTAINER_TIMEZONE}
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=users
Environment=FLUXER_SVC_MODE=router
Environment=FLUXER_SVC_MAX_CONCURRENT_REQUESTS=${FLUXER_SVC_MAX_CONCURRENT_REQUESTS}
AutoUpdate=${RUBBERVERSE_XYZ_CONTAINER_AUTOUPDATE}
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=${FLUXER_USERS_MEMORY_LIMIT}
Network=9Nats.network
UserNS=auto
