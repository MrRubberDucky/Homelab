[Unit]
Description=Fluxer Users Router
Requires=\
    fluxer-nats.service \
    fluxer-users-shard.service
After=fluxer-nats.service
Before=fluxer-users-shard.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=ghcr.io/fluxerapp/fluxer-users:v1
ContainerName=fluxer-users
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=users
Environment=FLUXER_SVC_MODE=router
Environment=FLUXER_SVC_MAX_CONCURRENT_REQUESTS=${FLUXER_SVC_MAX_CONCURRENT_REQUESTS}
Tmpfs=/tmp:rw,size=1m,noexec,nosuid,nodev
Tmpfs=/var/run:rw,size=1m,noexec,nosuid,nodev
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=64M
PodmanArgs=--cpus=2
PodmanArgs=--memory-swap=0M
Network=9Nats.network
UserNS=auto