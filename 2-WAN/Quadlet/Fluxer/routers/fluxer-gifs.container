[Unit]
Description=Fluxer Gifs Router
Requires=fluxer-nats.service
After=fluxer-nats.container
# current vibe: downright miserable

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=ghcr.io/fluxerapp/fluxer-gifs:v1
ContainerName=fluxer-gifs
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=gifs
Environment=FLUXER_SVC_MODE=router
Environment=FLUXER_MEDIA_PROXY_PUBLIC_ENDPOINT=${FLUXER_PUBLIC_SCHEME}://${FLUXER_DOMAIN}/media
Tmpfs=/tmp:rw,size=1m,noexec,nosuid,nodev
Tmpfs=/var/run:rw,size=1m,noexec,nosuid,nodev
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=64M
PodmanArgs=--cpus=2
PodmanArgs=--memory-swap=0M
Network=9Nats.network
UserNS=auto