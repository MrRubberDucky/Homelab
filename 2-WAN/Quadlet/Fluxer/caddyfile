{
	servers {
		trusted_proxies static {$FLUXER_EDGE_TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

{$FLUXER_EDGE_SITE_ADDRESS} {
	encode zstd gzip

	handle /_health {
		respond "OK" 200
	}

	handle_path /api/* {
		reverse_proxy {$pr}api:8080
	}

	handle /gateway {
		rewrite * /
		reverse_proxy {$pr}gateway:8080
	}

	handle_path /gateway/* {
		reverse_proxy {$pr}gateway:8080
	}

	handle_path /media/* {
		reverse_proxy {$pr}media-proxy:8080
	}

# Undocumment if running LK on same host
#	handle_path /livekit/* {
#		reverse_proxy {$pr}livekit:7880
#	}

	handle /admin {
		rewrite * /
		reverse_proxy {$pr}admin:8080
	}

	handle_path /admin/* {
		reverse_proxy {$pr}admin:8080
	}

	@staticAssets path /web/* /emoji/* /libs/* /avatars/* /badges/* /desktop/* /embeds/*
	handle @staticAssets {
		reverse_proxy {$pr}static-proxy:8080
	}

	handle /.well-known/fluxer {
		reverse_proxy {$pr}api:8080
	}

	handle {
		reverse_proxy {$pr}app-proxy:8080
	}
}

:8088 {
	handle /.well-known/fluxer {
		reverse_proxy {$pr}api:8080
	}
}
