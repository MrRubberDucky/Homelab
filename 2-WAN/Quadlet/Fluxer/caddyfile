{
		servers {
                trusted_proxies static {$FLUXER_EDGE_TRUSTED_PROXIES}
                trusted_proxies_strict
        }
}
{$FLUXER_EDGE_SITE_ADDRESS} {
        handle /_health {
                header -Via
                respond "OK" 200
        }
        handle_path /api/* {
                header -Via
                reverse_proxy fluxer-api:8080
        }
        handle /gateway {
                header -Via
                rewrite * /
                reverse_proxy fluxer-gateway:8080
        }
        handle_path /media/* {
                header -Via
                reverse_proxy fluxer-media-proxy:8080
        }
        handle /admin {
                header -Via
                rewrite * /
                reverse_proxy fluxer-admin:8080
        }
        handle_path /admin/* {
                header -Via
                reverse_proxy fluxer-admin:8080
        }
        @staticAssets path /web/* /emoji/* /libs/* /avatars/* /badges/* /desktop/*
        handle @staticAssets {
                header -Via
                reverse_proxy fluxer-static-proxy:8080
        }
        handle /.well-known/fluxer {
                header -Via
                reverse_proxy fluxer-api:8080
        }
        handle {
                header -Via
                reverse_proxy fluxer-app-proxy:8080
        }
}
:8088 {
        handle /.well-known/fluxer {
                header -Via
                reverse_proxy fluxer-api:8080
        }
}
