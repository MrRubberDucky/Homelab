[Unit]
Description=Fluxer Snowflakes Shard
Requires=fluxer-nats.service fluxer-snowflakes.service
After=fluxer-nats.container fluxer-snowflakes.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=${FLUXER_REGISTRY}/fluxer-snowflakes:${FLUXER_IMAGE_TAG}
ContainerName=fluxer-snowflakes-shard
Timezone=${RUBBERVERSE_XYZ_CONTAINER_TIMEZONE}
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_MODE=shard
Environment=FLUXER_SVC_SHARD_ID=0
AutoUpdate=${RUBBERVERSE_XYZ_CONTAINER_AUTOUPDATE}
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=${FLUXER_SNOWFLAKES_SHARD_MEMORY_LIMIT}
Network=9Nats.network
UserNS=auto
