[Unit]
Description=Fluxer Worker Service

Requires=\
    fluxer-postgres.service \
    fluxer-valkey.service \
    fluxer-nats.service \
    fluxer-users-shard.service \
    fluxer-messages-shard.service \
    fluxer-snowflakes-shard.service

After=\
    fluxer-postgres.service \
    fluxer-valkey.service \
    fluxer-nats.service \
    fluxer-snowflakes-shard.service \
    fluxer-users-shard.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=ghcr.io/fluxerapp/fluxer-api:v1
ContainerName=fluxer-worker
EnvironmentFile=%h/Fluxer/.env
Environment=NODE_OPTIONS=--enable-source-maps --max-old-space-size=2000mb
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=FLUXER_API_WORKER_MODE=all_lanes
Environment=FLUXER_API_WORKER_ENABLE_CRON_SCHEDULER=true
Environment=FLUXER_POSTGRES_MAX_CONNECTIONS=25
Exec=node dist/WorkerEntrypoint.js
Tmpfs=/tmp:rw,size=8m,noexec,nosuid,nodev
Tmpfs=/var/run:rw,size=1m,noexec,nosuid,nodev
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=2G
PodmanArgs=--cpus=1.7
PodmanArgs=--memory-swap=0M
Network=0Worker.network
Network=9Nats.network
Network=8Valkey.network
Network=7Postgres.network
Network=7Meilisearch.network
Network=6Seaweedfs.network
UserNS=auto
