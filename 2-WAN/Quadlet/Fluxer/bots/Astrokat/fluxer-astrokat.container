[Unit]
Description=Astrokat - A modular, multiplatform chatbot with features for both fun and uti>
Requires=fluxer-api.service
After=fluxer-api.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
ExecStartPre=sleep 20

[Container]
Image=ghcr.io/mizarc/astrokat:latest
ContainerName=fluxer-astrokat
EnvironmentFile=%h/Fluxer/.astro
Environment=TINI_SUBREAPER=1
Volume=ASTROKAT_DATA:/app/data:U,Z
Tmpfs=/tmp:rw,size=64m,noexec,nosuid,nodev
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=256M
PodmanArgs=--cpus=2
PodmanArgs=--memory-swap=0M
Network=_Astrokat.network
UserNS=auto:size=1002
