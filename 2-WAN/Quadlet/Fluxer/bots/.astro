# .env for Astrokat bot
ADAPTERS=fluxer
FLUXER_TOKEN=<redacted>
# This is how you would do it for default Fluxer deployment where everything listens on sub-paths by default
FLUXER_API_URL=https://chat.rubberverse.xyz/api
FLUXER_WEB_URL=https://chat.rubberverse.xyz
# Bot will still display ! as prefix in help messages unfortunately
DEFAULT_PREFIX=;
BOT_OPERATOR_IDS=<redacted>
RATE_LIMIT_USER_MAX=10
RATE_LIMIT_GUILD_MAX=100
RATE_LIMIT_WINDOW_MS=60000
