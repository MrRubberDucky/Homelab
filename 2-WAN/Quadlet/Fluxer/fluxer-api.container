[Unit]
Description=Fluxer API Service

# Dependency block of hell and despair
Requires=\
    fluxer-postgres.service \
    fluxer-valkey.service \
    fluxer-nats.service \
    fluxer-gateway.service \
    fluxer-meilisearch.service \
    fluxer-seaweedfs.service \
    fluxer-gifs.service \
    fluxer-gifs-shard.service \
    fluxer-users.service \
    fluxer-users-shard.service \
    fluxer-messages.service \
    fluxer-messages-shard.service \
    fluxer-snowflakes.service \
    fluxer-snowflakes-shard.service \
    fluxer-worker.service \
    fluxer-caddy.service

After=\
    fluxer-postgres.service \
    fluxer-valkey.service \
    fluxer-nats.service \
    fluxer-meilisearch.service \
    fluxer-seaweedfs.service \
    fluxer-gifs.service \
    fluxer-gifs-shard.service \
    fluxer-users.service \
    fluxer-users-shard.service \
    fluxer-messages.service \
    fluxer-messages-shard.service \
    fluxer-snowflakes.service \
    fluxer-snowflakes-shard.service \
    fluxer-worker.service

Before=\
        fluxer-caddy.service \
        fluxer-gateway.service

[Install]
WantedBy=multi-user.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=ghcr.io/fluxerapp/fluxer-api:v1
ContainerName=fluxer-api
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_API_PORT=${FLUXER_API_PORT}
Environment=NODE_OPTIONS=--enable-source-maps --max_old-space-size=${FLUXER_API_NODE_HEAP_MB}
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=FLUXER_API_PRESIGNED_ATTACHMENT_UPLOADS_ENABLED=${FLUXER_API_PRESIGNED_ATTACHMENT_UPLOADS_ENABLED}
Environment=FLUXER_POSTGRES_MAX_CONNECTIONS=25
Tmpfs=/tmp:rw,size=2G,noexec,nosuid,nodev
Tmpfs=/var/run:rw,size=1m,noexec,nosuid,nodev
HealthCmd=node -e "fetch('http://127.0.0.1:8080/_health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=10s
HealthRetries=30
HealthTimeout=5s
Notify=healthy
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=2G
PodmanArgs=--cpus=1.85
PodmanArgs=--memory-swap=0M
Network=0API.network
Network=6Seaweedfs.network
Network=7Postgres.network
Network=7Meilisearch.network
Network=8Valkey.network
Network=9Nats.network
UserNS=auto
