[Unit]
Description=Fluxer Users Shard
Requires=\
    fluxer-nats.service \
    fluxer-postgres.service \
    fluxer-users.service

After=\
    fluxer-nats.service \
    fluxer-postgres.service \
    fluxer-users.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv

[Container]
Image=${FLUXER_REGISTRY}/fluxer-users:${FLUXER_IMAGE_TAG}
ContainerName=fluxer-users-shard
Timezone=${RUBBERVERSE_XYZ_CONTAINER_TIMEZONE}
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=users
Environment=FLUXER_SVC_MODE=shard
Environment=FLUXER_SVC_SHARD_ID=0
Environment=FLUXER_POSTGRES_MAX_CONNECTIONS=${RUBBERVERSE_XYZ_USERS_SHARD_PG_MAX_CONNECTIONS}
Environment=FLUXER_SVC_MAX_CONCURRENT_REQUESTS=${FLUXER_SVC_MAX_CONCURRENT_REQUESTS}
AutoUpdate=${RUBBERVERSE_XYZ_CONTAINER_AUTOUPDATE}
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=${FLUXER_USERS_SHARD_MEMORY_LIMIT}
Network=9Nats.network
Network=7Postgres.network
UserNS=auto