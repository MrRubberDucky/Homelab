[Unit]
Description=Meilisearch for Fluxer
Requires=fluxer-api.service
Before=fluxer-api.service
After=fluxer-postgres.service fluxer-valkey.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.sysenv
EnvironmentFile=%h/Fluxer/.meilienv

[Container]
Image=docker.io/getmeili/meilisearch:v1
ContainerName=fluxer-meilisearch
EnvironmentFile=%h/Fluxer/.meilienv
Environment=MEILI_ENV=production
Environment=MEILI_NO_ANALYTICS=true
Environment=MEILI_MAX_INDEXING_MEMORY=${FLUXER_MEILISEARCH_MAX_INDEXING_MEMORY}
Environment=MEILI_MASTER_KEY=${MASTER_KEY}
Environment=MEILI_UPGRADE_DB=true
# This only touches the actual meilisearch binary(?), LMDB is uncapped still.
# See: https://github.com/meilisearch/meilisearch/issues/4764
Environment=MEILI_MAX_INDEXING_MEMORY=512M
Environment=MEILI_EXPERIMENTTAL_REDUCE_INDEXING_MEMORY_USAGE=true
Volume=/srv/fluxer/meili:/meili_data:U,Z
Tmpfs=/tmp:rw,size=1m,noexec,nosuid,nodev
Tmpfs=/var/run:rw,size=1m,noexec,nosuid,nodev
HealthCmd=wget -q -O /dev/null http://127.0.0.1:7700/health
HealthInterval=10s
HealthRetries=10
HealthTimeout=5s
Notify=healthy
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
# May cause OOM still when indexing is ran. Depends on LMDB size.
Memory=1G
PodmanArgs=--cpus=2
PodmanArgs=--memory-swap=0M
User=1100:1100
UserNS=auto:size=1101
Network=7Meilisearch.network
