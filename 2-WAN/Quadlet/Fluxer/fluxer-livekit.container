# This is separate from main Fluxer stack. I'm deploying LiveKit on VPS since it has the most bandwidth compared to my home network.
# You'll need to add dependencies yourself, easier method is just to link this to internal Redis container.
# Try replacing following below with this:
# Requires=fluxer-valkey.service fluxer-gateway.service
# After=fluxer-valkey.service
# Before=fluxer-gateway.service
[Unit]
Description=LiveKit
Requires=valkey.service
After=valkey.service

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Install]
WantedBy=default.target

[Container]
Image=docker.io/livekit/livekit-server:latest
ContainerName=livekit-server
Environment=GOMEMLIMIT=1700MiB
Exec=--config /etc/livekit.yaml
Volume=%h/Configs/LiveKit/livekit.yaml:/etc/livekit.yaml:ro,Z,nosuid,noexec,nodev
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Network=livekit.network
# Not open publicly, wireguard tunnel talks to it directly
PublishPort=0.0.0.0:7880:7880
# 7881/tcp and 7882/udp should be open
PublishPort=0.0.0.0:7881:7881/tcp
PublishPort=0.0.0.0:7882:7882/udp
Network=valkey-livekit.network
# Loopback for proper DNAT
AddHost=chat.rubberverse.xyz:169.254.1.2
Memory=2G
User=1100:1100
UserNS=auto:size=1101
